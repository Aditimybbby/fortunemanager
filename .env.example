# Required: your own Discord bot token. TOKEN is also accepted for compatibility.
DISCORD_TOKEN=
# Application ID and OAuth2 client secret from Discord Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Register exactly this redirect URI: http://localhost:8080/auth/callback
# For hosting, use your public HTTPS domain and set host to 0.0.0.0 behind a TLS proxy.
DASHBOARD_URL=http://localhost:8080
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
ENABLE_DASHBOARD=1
DEFAULT_PREFIX=.
# Optional bot-owner IDs (comma separated). No old owner IDs are included.
OWNER_IDS=
# Optional absolute persistent data directory (default data/fortune inside this project).
# DATA_DIR=/var/lib/fortunemanager
# Replace expiring Discord attachment URLs with durable HTTPS URLs when needed.
# BRAND_LOGO_URL=https://your-domain.example/fortune-logo.png
# BRAND_BANNER_URL=https://your-domain.example/fortune-banner.png
# Original features are retained in cogs/ and can be explicitly enabled.
# Install requirements-legacy.txt first; see README for limitations.
LEGACY_COGS=
ENABLE_PRESENCES=0

# Railway: attach a Volume mounted at /data and set DATA_DIR=/data.
# PORT is supplied by Railway and overrides DASHBOARD_PORT.
# On Railway use DASHBOARD_HOST=0.0.0.0 and a public HTTPS DASHBOARD_URL.
